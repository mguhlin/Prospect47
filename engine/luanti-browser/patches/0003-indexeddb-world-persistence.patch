+const PERSISTENT_WORLDS_PATH = '/Luanti/worlds';
+window.p47Persistence = { ready: false, error: null };
+
+function preparePersistentWorlds() {
+    FS.mkdirTree(PERSISTENT_WORLDS_PATH);
+    FS.mount(IDBFS, { autoPersist: true }, PERSISTENT_WORLDS_PATH);
+    addRunDependency('p47-worlds-indexeddb');
+    FS.syncfs(true, (error) => {
+        if (error) {
+            window.p47Persistence.error = String(error);
+            consolePrint('Failed to hydrate persistent worlds: ' + error);
+        } else {
+            window.p47Persistence.ready = true;
+            consolePrint('Persistent worlds ready (IndexedDB)');
+        }
+        removeRunDependency('p47-worlds-indexeddb');
+    });
+}
+
+function flushPersistentWorlds() {
+    if (!window.p47Persistence.ready) return;
+    FS.syncfs(false, (error) => {
+        if (!error) return;
+        window.p47Persistence.error = String(error);
+        consolePrint('Failed to persist worlds: ' + error);
+    });
+}
